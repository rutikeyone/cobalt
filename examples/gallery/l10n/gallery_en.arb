  "@namedTeaches": {
    "description": "One line: what \"Named and multi-injection\" exists to show."
  },
  "namedPoint1": "@Named picks one registration of a type that has several",
  "namedPoint2": "getAll returns every registration of a type, in registration order",
  "namedPoint3": "A duplicate of the same key in one scope is an error, not a silent last-one-wins",
  "widgetScopeTitle": "Widget-owned scope",
  "@widgetScopeTitle": {
    "description": "Name of the \"Widget-owned scope\" example."
