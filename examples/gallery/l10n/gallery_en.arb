  "environmentsTeaches": "One interface, a different implementation per build.",
  "@environmentsTeaches": {
    "description": "One line: what \"Environments\" exists to show."
  },
  "environmentsPoint1": "@CobaltEnvironment repeats rather than taking a list — a registration belongs to a set, a start picks one",
  "environmentsPoint2": "Two registrations whose environments overlap fail the build, not the app",
  "environmentsPoint3": "Choosing nothing leaves the split types unregistered, so the miss is loud",
  "environmentsPoint4": "Manual Mode writes the same `if` the generator emits",
  "lazyAsyncTitle": "Lazy async",
