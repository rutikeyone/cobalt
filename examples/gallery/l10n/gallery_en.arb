  "startupTitle": "Two-phase startup",
  "@startupTitle": {
    "description": "Name of the \"Two-phase startup\" example."
  },
  "startupTeaches": "Bootstrap steps run before a container exists; async initializers run as a graph.",
  "@startupTeaches": {
    "description": "One line: what \"Two-phase startup\" exists to show."
  },
  "startupPoint1": "Phase 0 steps are adopted by the root scope and released with it",
  "startupPoint2": "A step that opened something is closed last, after everything built on it",
  "startupPoint3": "Phase 1 awaits @CobaltInit as a graph, so independent branches run together",
  "startupPoint4": "dependsOn decides the order — you never write the sequence yourself",
  "environmentsTitle": "Environments",
  "@environmentsTitle": {
    "description": "Name of the \"Environments\" example."
